ENVIRONMENT=development
DATABASE_PATH=data/nexus.db
# Production: PostgreSQL instead of the SQLite file above, e.g. postgresql://nexus:password@db:5432/nexus.
# The schema is created on first start. Set NEXUS_SECRET_KEY explicitly with it, and back up with pg_dump.
# DATABASE_URL=
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Hostnames Nexus may be reached by besides localhost and IP addresses (e.g. nexus.home.lan). Anything else is
# refused, which stops other websites pointing their own name at this machine (DNS rebinding).
# NEXUS_ALLOWED_HOSTS=
# Generate a unique key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
NEXUS_SECRET_KEY=
LOG_LEVEL=info

# Accounts: the first account made is the owner (admin), and anyone can sign up after it; each account's chats,
# apps, workflows, documents, files and keys are private to it. Set to "closed" to stop new sign-ups (the admin
# can also open or close them in Settings > Admin).
# NEXUS_SIGNUPS=closed
# Sign-in cookies only over HTTPS (set automatically when the request is HTTPS; force it behind a proxy).
# NEXUS_SECURE_COOKIES=true

# ---- Publishing: addresses, email and Google sign-in ----
# Where people open Nexus (links in emails, and the return from Google sign-in go there).
# NEXUS_APP_URL=https://nexus.example.com
# Where the API is reached, if not the same address (Google's redirect URI is <this>/api/auth/google/callback).
# NEXUS_PUBLIC_URL=https://nexus.example.com
# Email (verify new accounts, reset passwords). Set ONE of: SMTP, Resend, or a folder (development).
# With none set, nothing is emailed and new accounts don't need to verify.
# NEXUS_MAIL_FROM=Nexus <no-reply@nexus.example.com>
# NEXUS_SMTP_HOST=smtp.example.com
# NEXUS_SMTP_PORT=587
# NEXUS_SMTP_USER=
# NEXUS_SMTP_PASSWORD=
# NEXUS_RESEND_API_KEY=
# NEXUS_MAIL_DIR=data/mail
# "Continue with Google": an OAuth client (Web application) in Google Cloud, separate from the Gmail integration's.
# NEXUS_GOOGLE_CLIENT_ID=
# NEXUS_GOOGLE_CLIENT_SECRET=
# Error reports: set to your Sentry project DSN to receive crashes (no passwords, cookies or personal data are sent).
# SENTRY_DSN=
